{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-shortener",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true,
  },
  "vars": {
    // The React app. Anyone opening the bare short-link host is sent here.
    "FRONTEND_URL": "http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "url-shortener",
      // database_id is added in Phase 6, once the production database exists.
    },
  ],
  "triggers": {
    // Daily at 03:17 UTC: delete links that expired more than 30 days ago.
    "crons": ["17 3 * * *"],
  },
  // namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "GUEST_LINK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "AVAILABILITY_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "USER_LINK_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
